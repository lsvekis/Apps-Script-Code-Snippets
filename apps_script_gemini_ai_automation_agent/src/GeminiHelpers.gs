const GEMINI_MODEL="gemini-2.5-flash";function callGemini(p,t){const k=PropertiesService.getScriptProperties().getProperty("GEMINI_API_KEY");if(!k)throw new Error("Set GEMINI_API_KEY in Script Properties.");const u="https://generativelanguage.googleapis.com/v1/models/"+GEMINI_MODEL+":generateContent?key="+encodeURIComponent(k);const r=UrlFetchApp.fetch(u,{method:"post",contentType:"application/json",payload:JSON.stringify({contents:[{parts:[{text:p+(t?"\n\n"+t:"")}]}]}),muteHttpExceptions:true});const j=JSON.parse(r.getContentText());if(j.error)throw new Error(j.error.message);return j.candidates[0].content.parts[0].text;}