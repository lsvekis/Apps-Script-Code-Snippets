function validateAgentPlan_(p){if(!p||!Array.isArray(p.steps))throw new Error("Invalid plan.");if(p.steps.length>6)throw new Error("Too many steps.");const a=getAvailableTools_().map(x=>x.name),seen=[];p.steps.forEach(s=>{if(!a.includes(s.tool))throw new Error("Unsupported tool: "+s.tool);if(s.tool==="analyzeData"&&!seen.includes("readSheetData"))throw new Error("analyzeData requires readSheetData.");if(["createGoogleDoc","createGmailDraft"].includes(s.tool)&&!seen.includes("analyzeData"))throw new Error(s.tool+" requires analyzeData.");seen.push(s.tool)});return true;}